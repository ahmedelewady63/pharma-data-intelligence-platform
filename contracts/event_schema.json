{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "v1 DRAFT. Field names are real FAERS names (DEMO/DRUG/REAC/OUTC). One event = one FAERS drug record (primaryid x drug_seq) carrying report-level fields. Change only through a contracts PR approved by members 1, 4 and 5.",
  "title": "PharmaDrugEvent",
  "type": "object",
  "required": ["event_id", "schema_version", "source", "primaryid", "drug_seq", "drugname", "produced_at"],
  "properties": {
    "event_id": {"type": "string", "description": "primaryid + '-' + drug_seq (stable, used for deduplication)"},
    "schema_version": {"type": "string", "const": "1.0"},
    "source": {"type": "string", "enum": ["FAERS", "SYNTHETIC"]},
    "primaryid": {"type": "string"},
    "caseid": {"type": ["string", "null"]},
    "caseversion": {"type": ["integer", "null"]},
    "drug_seq": {"type": "integer"},
    "role_cod": {"type": ["string", "null"]},
    "drugname": {"type": ["string", "null"]},
    "prod_ai": {"type": ["string", "null"]},
    "route": {"type": ["string", "null"]},
    "dose_form": {"type": ["string", "null"]},
    "dose_amt": {"type": ["number", "null"]},
    "dose_unit": {"type": ["string", "null"]},
    "dose_freq": {"type": ["string", "null"]},
    "nda_num": {"type": ["string", "null"]},
    "reactions": {"type": "array", "items": {"type": "string"}, "description": "REAC.pt values of the same report"},
    "outcomes": {"type": "array", "items": {"type": "string"}, "description": "OUTC.outc_cod values of the same report"},
    "age": {"type": ["number", "null"], "description": "years"},
    "age_cod": {"type": ["string", "null"]},
    "sex": {"type": ["string", "null"]},
    "occp_cod": {"type": ["string", "null"]},
    "reporter_country": {"type": ["string", "null"]},
    "occr_country": {"type": ["string", "null"]},
    "event_dt": {"type": ["string", "null"], "description": "YYYY-MM-DD or null"},
    "fda_dt": {"type": ["string", "null"], "description": "YYYY-MM-DD or null"},
    "produced_at": {"type": "string", "format": "date-time", "description": "UTC ISO-8601, set by the producer"}
  },
  "additionalProperties": false
}
