# Copy to .env and edit. NEVER commit .env.

# Data folder outside the repo and outside OneDrive/Dropbox. Edit this path for your machine.
# Windows example: D:/Pharma Project/data      Linux/Docker example: /data
DATA_DIR=~/pharma-data

# Kafka (local Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=pharma.drug.events.v1
KAFKA_TOPIC_DLQ=pharma.drug.events.dlq.v1

# Spark Structured Streaming
SPARK_CHECKPOINT_DIR=./data/checkpoints

# Only needed to download the FULL RxNorm release (UMLS license). Never commit a real key.
UMLS_API_KEY=

LOG_LEVEL=INFO
